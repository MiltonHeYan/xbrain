{
  "name": "xstash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first resource memory Skill and minimal bookmark gallery. Bring your own Agent, source and personal memory provider.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "check": "npm run typecheck",
    "build": "node scripts/build.mjs",
    "test": "npm run build && npm run test:core && npm run test:ui",
    "test:core": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/client/**/*.{ts,tsx}\" \"*config*.{json,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/client/**/*.{ts,tsx}\" \"*config*.{json,ts}\""
  },
  "license": "MIT",
  "keywords": [
    "bookmarks",
    "x",
    "local-first",
    "bring-your-own-agent",
    "resource-memory"
  ],
  "files": [
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "cli.mjs",
    "server.mjs",
    "index.html",
    "tsconfig.json",
    "vite.config.ts",
    "src/",
    "lib/",
    "scripts/",
    "docs/",
    "examples/"
  ],
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
